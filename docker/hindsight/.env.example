# Copy to .env (gitignored) and fill in. Generate secrets with:
#   openssl rand -hex 24

# Postgres
HINDSIGHT_DB_USER=hindsight_user
HINDSIGHT_DB_NAME=hindsight_db
HINDSIGHT_DB_VERSION=18
HINDSIGHT_DB_PASSWORD=

# Hindsight image tag (docker/docker-compose/external-pg convention)
HINDSIGHT_VERSION=latest

# LLM provider: CliProxyAPI (https://github.com/router-for-me/CLIProxyAPI), an
# OpenAI-compatible gateway on the host, reached via host network mode.
CLIPROXY_API_KEY=
CLIPROXY_BASE_URL=http://127.0.0.1:9988/v1
HINDSIGHT_API_LLM_MODEL=gemini-3.7-flash-high

# API auth — required on every /v1/* request as `Authorization: Bearer <token>`
HINDSIGHT_API_TENANT_API_KEY=

# Control Plane (Web UI, http://localhost:9999) login key
HINDSIGHT_CP_ACCESS_KEY=
